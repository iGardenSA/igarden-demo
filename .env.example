# iGarden Smart OS Demo — environment variables
# Copy to .env.local for local dev. On Vercel: add via project settings (G4).

# Public — sent to the browser. Anon key has SELECT-only permissions via RLS.
NEXT_PUBLIC_SUPABASE_URL=https://ewcmosjxbqtzmkzakojn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose. Bypasses RLS. Used by server components,
# Server Actions, and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
